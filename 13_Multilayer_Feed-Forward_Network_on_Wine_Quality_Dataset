import time, pandas as pd, numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

print("Loading Wine Quality Dataset...")
data = pd.read_csv("https://archive.ics.uci.edu/ml/machine-learning-databases/wine-quality/winequality-red.csv", sep=";")
print("Dataset shape:", data.shape)
print("\nFirst five rows:\n", data.head())

X, y = data.drop("quality", axis=1), data["quality"]
print("\nFeature shape:", X.shape)
print("Target shape:", y.shape)
print("Quality values:", sorted(y.unique()))
print("Missing values:\n", data.isnull().sum())

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42, stratify=y)
print("\nTraining samples:", X_train.shape[0])
print("Testing samples:", X_test.shape[0])

scaler = StandardScaler()
X_train, X_test = scaler.fit_transform(X_train), scaler.transform(X_test)
print("\nTraining data after scaling:\nMean:", round(X_train.mean(), 4), "\nStandard deviation:", round(X_train.std(), 4))

results, arches = [], [
    ("1 Hidden Layer - 16 Neurons", (16,)),
    ("1 Hidden Layer - 32 Neurons", (32,)),
    ("2 Hidden Layers - 32,16", (32, 16)),
    ("2 Hidden Layers - 64,32", (64, 32)),
    ("3 Hidden Layers - 64,32,16", (64, 32, 16))
]

for name, arch in arches:
    print(f"\nTraining: {name}")
    t0 = time.time()
    mlp = MLPClassifier(hidden_layer_sizes=arch, activation="relu", solver="adam", max_iter=500, random_state=42).fit(X_train, y_train)
    tt, yp = time.time() - t0, mlp.predict(X_test)
    acc, prec, rec, f1 = accuracy_score(y_test, yp), precision_score(y_test, yp, average="macro", zero_division=0), recall_score(y_test, yp, average="macro", zero_division=0), f1_score(y_test, yp, average="macro", zero_division=0)
    results.append({"Architecture": name, "Accuracy": round(acc, 4), "Precision": round(prec, 4), "Recall": round(rec, 4), "F1-score": round(f1, 4), "Training Time (s)": round(tt, 2)})
    print(f"Accuracy: {acc:.4f} | Precision: {prec:.4f} | Recall: {rec:.4f} | F1: {f1:.4f} | Time: {tt:.2f}s")

df = pd.DataFrame(results)
print("\n--- Performance Comparison ---\n", df.to_string(index=False))

best = df.loc[df["Accuracy"].idxmax()]
print(f"\n--- Best Performing Architecture ---\nArchitecture : {best['Architecture']}\nBest Accuracy: {best['Accuracy']}\nPrecision    : {best['Precision']}\nRecall       : {best['Recall']}\nF1-score     : {best['F1-score']}\nTraining Time: {best['Training Time (s)']} seconds")
